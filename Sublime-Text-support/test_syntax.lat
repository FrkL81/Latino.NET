# Comentario de prueba
funcion saludar(nombre)
    si nombre != nulo
        mensaje = "Hola " .. nombre
        escribir(mensaje)
    sino
        escribir("Nombre inválido")
    fin
fin

clase Persona
    constructor(nombre, edad)
        mi.nombre = nombre
        mi.edad = edad
    fin
    
    funcion presentarse()
        retornar ç("Soy |mi.nombre|, tengo |mi.edad| años")
    fin
fin

