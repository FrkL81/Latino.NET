{
    "name": "Latino.NET en la Nube",
    // La imagen debe incluir el runtime que exige el LSP (TargetFramework net10.0).
    // Si el LSP sube de versión en el futuro, actualizar este tag.
    "image": "mcr.microsoft.com/devcontainers/dotnet:10.0-noble",
    "hostRequirements": { "cpus": 2 },
    "containerEnv": {
        "LATINO_HOME": "/opt/latino"
    },
    "postCreateCommand": "bash .devcontainer/setup.sh",
    "postAttachCommand": "bash .devcontainer/install-extension.sh",
    "customizations": {
        "codespaces": {
            "openFiles": ["ejemplos/01_hola_mundo.lat"]
        },
        "vscode": {
            "extensions": ["${containerWorkspaceFolder}/.devcontainer/latino-net.vsix"],
            "settings": {
                "workbench.colorTheme": "Latino.NET Dark",
                "latino.binaryPath": "/opt/latino/latino"
            }
        }
    }
}
