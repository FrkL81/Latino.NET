<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>false</PublishAot>
    <AssemblyName>latino</AssemblyName>
    <ApplicationIcon>Resources\app_icon.ico</ApplicationIcon>
    <Version>1.0.81</Version>
    <AssemblyVersion>1.0.81.0</AssemblyVersion>
    <FileVersion>1.0.81.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Latino.Core/Latino.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Manual*.pdf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
